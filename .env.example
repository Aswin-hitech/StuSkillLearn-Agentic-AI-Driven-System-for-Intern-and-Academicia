# StuSkillLink / SIH26044
DATABASE_URL=sqlite:///./stuskilllink.db
JWT_SECRET_KEY=change-this-before-production-use-32-plus-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_SEED_DEMO=true

# NVIDIA NIM hosted API (or replace base URL with a self-hosted NIM endpoint)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
# Optional embedding-capable NIM model; leave blank until you select a currently supported model from /v1/models.
NVIDIA_NIM_EMBEDDING_MODEL=

# LLM failover. The first configured, healthy provider is used. OpenRouter's
# default routes only to currently available zero-cost models.
LLM_PROVIDER_PRIORITY=nvidia,groq,gemini,openrouter
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional production integrations. Core product works without them.
MONGODB_URI=
SMTP_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
LANGGRAPH_CHECKPOINT_PATH=./langgraph-checkpoints.sqlite
LANGGRAPH_STRICT_MSGPACK=true
