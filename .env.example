# Local/demo environment only. Never reuse these defaults in production.
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite:///./stuskilllink.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=stuskilllink-local-development-secret-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,backend,frontend
PUBLIC_APP_URL=http://localhost:5173
AUTO_CREATE_SCHEMA=true
AUTO_SEED_DEMO=true
SECURE_COOKIES=false
COOKIE_SAMESITE=lax
REQUIRE_EMAIL_VERIFICATION=false

# NVIDIA NIM hosted API (or replace the base URL with a self-hosted NIM endpoint).
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_EMBEDDING_MODEL=

# Ordered LLM failover. Core decisions remain deterministic when all providers are unavailable.
LLM_PROVIDER_PRIORITY=nvidia,groq,gemini,openrouter
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional integrations.
MONGODB_URI=
SMTP_URL=
SMTP_FROM_EMAIL=noreply@stuskilllink.local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Frontend + agent checkpointing
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SHOW_DEMO_ACCOUNTS=true
LANGGRAPH_CHECKPOINT_PATH=./langgraph-checkpoints.sqlite
LANGGRAPH_STRICT_MSGPACK=true
