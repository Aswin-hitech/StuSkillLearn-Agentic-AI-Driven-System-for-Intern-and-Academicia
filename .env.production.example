# Required production settings. Copy to a secret-managed environment; do not commit real values.
PUBLIC_APP_URL=https://stuskill.example.com
ALLOWED_HOSTS=stuskill.example.com
PUBLIC_PORT=8080
DATABASE_URL=postgresql+psycopg://stuskilllink:CHANGE_ME@postgres.example.com:5432/stuskilllink?sslmode=require
REDIS_URL=rediss://:CHANGE_ME@redis.example.com:6380/0
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_FROM_EMAIL=noreply@stuskill.example.com

# Optional AI providers. Deterministic ranking/allocation never depends on an LLM.
LLM_PROVIDER_PRIORITY=nvidia,groq,gemini,openrouter
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional integrations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MONGODB_URI=

# Production frontend must never expose seeded demo sign-in controls.
VITE_SHOW_DEMO_ACCOUNTS=false
